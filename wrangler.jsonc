{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: beacon.lukeghanna.com (custom domain added at DNS cutover).
  "name": "beacon",
  "routes": [
    { "pattern": "beacon.lukeghanna.com", "custom_domain": true }
  ],
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: pg's sockets, node:crypto, node:async_hooks, and process.env from vars/secrets.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Worker always talks to Postgres (DATABASE_URL, or Hyperdrive when bound); keep the PGlite WASM out of the bundle.
  "alias": { "@electric-sql/pglite": "./worker/no-pglite.ts" },
  // Run the Worker near the database (Neon) instead of near the visitor: fewer round trips per request.
  "placement": { "mode": "smart" },
  // Per-IP limits on the two write endpoints and the read-only MCP endpoint (checked in worker/rateLimit.ts). Free plan; period is 10 or 60 s.
  "ratelimits": [
    { "name": "ACTIONS_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RESET_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
  ],
  // Optional Hyperdrive (connection pooling and caching in front of Neon). To enable:
  //   npx wrangler hyperdrive create beacon-db --connection-string="<neon connection string>"
  // then paste the id it prints below and uncomment. The Worker uses this binding when present
  // and falls back to the DATABASE_URL secret otherwise. Repeat the block under env.presenter if wanted.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" }],
  // Nightly demo reset at 04:00 UTC, then the synthetic market signals that have come due; the hourly
  // trigger applies only those (worker/index.ts scheduled). Secret: DATABASE_URL.
  "triggers": { "crons": ["0 4 * * *", "0 * * * *"] },
  "observability": { "enabled": true },
  "env": {
    // Presenter deployment (beacon-presenter): same build on a workers.dev URL, pointed at its own
    // Neon branch via `wrangler secret put DATABASE_URL --env presenter`. Same nightly reset as production; no custom domain.
    // Bindings are not inherited by named environments, so the rate limits are repeated here.
    "presenter": {
      "name": "beacon-presenter",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": ["0 4 * * *", "0 * * * *"] },
      "ratelimits": [
        { "name": "ACTIONS_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
        { "name": "RESET_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
        { "name": "MCP_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
      ],
    },
  },
}
