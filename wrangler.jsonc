{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: beacon.lukeghanna.com (custom domain added at DNS cutover).
  "name": "beacon",
  "routes": [{ "pattern": "beacon.lukeghanna.com", "custom_domain": true }],
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: pg's sockets, node:crypto, node:async_hooks, and process.env from vars/secrets.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Worker always talks to Postgres (DATABASE_URL, or Hyperdrive when bound); keep the PGlite WASM out of the bundle.
  "alias": { "@electric-sql/pglite": "./worker/no-pglite.ts" },
  // Run the Worker near the database (Neon) instead of near the visitor: fewer round trips per request.
  "placement": { "mode": "smart" },
  // Per-IP limits on the two write endpoints and the read-only MCP endpoint (checked in worker/rateLimit.ts). Free plan; period is 10 or 60 s.
  "ratelimits": [
    { "name": "ACTIONS_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RESET_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
  ],
  // Hyperdrive pools connections to Neon (config beacon-neon: the neondb database on the direct, non-pooler
  // host, query caching off so a read never trails a write). The Worker uses it in place of the
  // DATABASE_URL secret, which stays as the fallback. Bindings are not inherited: the presenter uses its secret.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "82a4ae53c6a74e4bb9bad76ad7c562c7" }],
  // One hourly trigger: the 04:00 UTC run is the nightly demo reset, then the synthetic market signals
  // that have come due; every other run applies only those (worker/index.ts scheduled). Secret: DATABASE_URL.
  "triggers": { "crons": ["0 * * * *"] },
  // The 04:00 UTC run also resets the presenter deployment, which has no Cron Trigger of its own:
  // the account's five are in use. A named entrypoint is reachable only through this binding.
  "services": [
    { "binding": "PRESENTER", "service": "beacon-presenter", "entrypoint": "PresenterNightly" },
  ],
  "observability": { "enabled": true },
  "env": {
    // Presenter deployment (beacon-presenter): same build on a workers.dev URL, pointed at its own
    // Neon database via `wrangler secret put DATABASE_URL --env presenter`. Same nightly reset as production; no custom domain.
    // It has no Cron Trigger (the account's five are in use): production's 04:00 UTC run resets it
    // through the PRESENTER service binding, then its due signals are applied.
    // Bindings are not inherited by named environments, so the rate limits are repeated here.
    "presenter": {
      "name": "beacon-presenter",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      "ratelimits": [
        {
          "name": "ACTIONS_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 },
        },
        { "name": "RESET_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
        { "name": "MCP_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
      ],
    },
  },
}
