{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: beacon.lukeghanna.com (custom domain added at DNS cutover).
  "name": "beacon",
  "routes": [
    { "pattern": "beacon.lukeghanna.com", "custom_domain": true }
  ],
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: pg's sockets, node:crypto, node:async_hooks, and process.env from vars/secrets.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Worker always talks to Postgres over DATABASE_URL; keep the PGlite WASM out of the bundle.
  "alias": { "@electric-sql/pglite": "./worker/no-pglite.ts" },
  // Nightly demo reset (was the Vercel cron on /api/reset). Secrets: DATABASE_URL, CRON_SECRET.
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true },
  "env": {
    // The second Vercel project (beacon-demo-two.vercel.app): same build, no database, no cron.
    "demo": {
      "name": "beacon-demo",
      "workers_dev": true,
      "triggers": { "crons": [] },
    },
  },
}
