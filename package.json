{
  "name": "beacon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "check": "node scripts/check-sanitized.mjs && npm run lint && npm run format:check && npm run typecheck && vitest run",
    "format": "prettier --write src/ server/ shared/ api/ scripts/ worker/",
    "format:check": "prettier --check src/ server/ shared/ api/ scripts/ worker/",
    "seed": "tsx scripts/seed.ts",
    "extract": "tsx scripts/extract.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:presenter": "npm run build && wrangler deploy --env presenter",
    "cf:dev": "npm run build && wrangler dev --env=\"\"",
    "e2e": "playwright test --grep-invert @shots",
    "shots": "playwright test --grep @shots"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@blueprintjs/core": "^6.10.0",
    "@blueprintjs/icons": "^6.7.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.103.2",
    "normalize.css": "^8.0.1",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.65.0",
    "@trivago/prettier-plugin-sort-imports": "^5.0.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.147.0"
  }
}
