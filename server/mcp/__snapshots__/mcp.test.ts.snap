exports[`tools > lists exactly three read-only tools, with their schemas 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Find advisory firms in Beacon's synthetic universe by name, sector, headquarters country, scoring model, tier or pipeline stage. Returns each firm's live score and tier, best first. If the reply has partial: true, only the first firms in name order were searched, so the matches and totalMatches may be incomplete and the order is best first within that part: narrow the query (a name, sector, country or stage) and search again.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "firmType": {
          "description": "Scoring model: CF (corporate finance) or CS (capital solutions).",
          "enum": [
            "CF",
            "CS",
          ],
          "type": "string",
        },
        "hqCountry": {
          "description": "Headquarters country (case-insensitive, exact).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "description": "How many to return, 1 to 25 (default 10). A larger number is treated as 25.",
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Part of the firm's name (case-insensitive).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "sector": {
          "description": "Sector, e.g. Software (case-insensitive, exact).",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "stage": {
          "description": "Pipeline stage.",
          "enum": [
            "Discovered",
            "Screening",
            "Qualified",
            "Outreach",
            "NDA",
            "IOI",
            "LOI",
            "Closed",
            "Passed",
          ],
          "type": "string",
        },
        "tier": {
          "description": "The live rubric tier, as the Desk shows it.",
          "enum": [
            "A",
            "B",
            "C",
            "Rejected",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "search_firms",
    "title": "Search firms",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "For one firm, every rubric axis with the value Beacon shows, its status (verified, proposed, signal, abstained, conflict), and the citation behind it: provider, the source sentence quoted and the extraction model. An open conflict lists its two sides.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "firmId": {
          "description": "The firm's id, as search_firms returns it.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "firmId",
      ],
      "type": "object",
    },
    "name": "get_firm_evidence",
    "title": "Get a firm's evidence",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Screening rules proposed from analysts' pass decisions, pending or approved, with the predicate in words (e.g. employees < 10), the firms supporting it and its projected impact.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "How many to return, 1 to 25 (default 10). A larger number is treated as 25.",
          "minimum": 1,
          "type": "integer",
        },
        "status": {
          "description": "Only rules awaiting a decision, or only approved ones. Both when omitted.",
          "enum": [
            "pending",
            "approved",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_rules",
    "title": "List screening rules",
  },
]
